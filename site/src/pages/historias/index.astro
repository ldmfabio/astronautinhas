---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const stories=(await getCollection('historias')).filter(s=>!s.data.draft && s.data.publicacao?.site !== false).sort((a,b)=>a.data.numero-b.data.numero);
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const assetUrl = (path) => `${base}${path.replace(/^.*?assets\//, 'assets/')}`;
---
<Base title="Histórias | Astronautinhas"><h1>Todas as histórias</h1>{stories.length ? <section class="grid">{stories.map(s=><a class="card" href={url(`historias/${s.data.slug}/`)}><img src={assetUrl(s.data.imagem)} alt={`Ilustração de ${s.data.titulo}`}/><div class="content"><small>Aventura #{s.data.numero}</small><h2>{s.data.titulo}</h2></div></a>)}</section> : <section class="empty"><h2>Acervo em preparação</h2><p>Nenhuma história foi liberada para publicação ainda.</p></section>}</Base>
