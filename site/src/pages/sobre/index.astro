---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const paginas = (await getCollection('paginas'))
  .filter((pagina) => !pagina.data.draft && pagina.data.ordem > 0)
  .sort((a, b) => a.data.ordem - b.data.ordem);

const secoes = await Promise.all(
  paginas.map(async (pagina) => {
    const { Content } = await render(pagina);
    return { pagina, Content };
  })
);
---
<Base title="Sobre os Astronautinhas" description="Conheça a origem do Astronauta Espaguete e da Astronauta Penne e a história familiar por trás das aventuras dos Astronautinhas.">
  <article class="prose">
    {secoes.map(({ pagina, Content }) => (
      <section id={pagina.id}>
        <Content />
      </section>
    ))}
  </article>
</Base>
