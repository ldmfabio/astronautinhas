---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
const {
  title = 'Astronautinhas',
  description = 'As aventuras do Astronauta Espaguete e da Astronauta Penne',
  image,
  type = 'website',
  structuredData
} = Astro.props;
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;
const isProd = import.meta.env.PROD;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<Seo title={title} description={description} image={image} type={type} structuredData={structuredData}/>
<meta name="theme-color" content="#4338ca"/>
<meta name="application-name" content="Astronautinhas"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
<meta name="apple-mobile-web-app-title" content="Astronautinhas"/>
<link rel="manifest" href={url('manifest.webmanifest')}/>
<link rel="icon" href={url('icons/astronautinhas.svg')} type="image/svg+xml"/>
{isProd && (
  <>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F8Y59SGWJ2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F8Y59SGWJ2');
    </script>
  </>
)}
</head>
<body>
<header class="topbar"><a class="brand" href={url()}>🚀 Astronautinhas</a><nav><a href={url('historias/')}>Histórias</a><a href={url('sobre/')}>Sobre</a></nav></header>
<main><slot /></main>
<footer><strong>Astronautinhas</strong><span>As aventuras do Astronauta Espaguete e da Astronauta Penne.</span></footer>
{isProd && (
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js');
      });
    }
  </script>
)}
</body></html>
